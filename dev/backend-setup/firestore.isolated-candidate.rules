rules_version = '2';
// LOCAL REVIEW CANDIDATE ONLY — isolated blakeout-darts-dev, default database.
// Not referenced by root firebase.json. Not compiled, deployed or release-ready.
// See ISOLATED_RULES_REVIEW.md for scope, residual risks and test requirements.
service cloud.firestore {
  match /databases/{database}/documents {
    function devVerified() {
      return database == '(default)' && request.auth != null
        && devId(request.auth.uid)
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '')
          in ['password', 'google.com'];
    }

    function devText(value, maximum) {
      return value is string && value.size() <= maximum
        && value.matches('^[^@]*$');
    }

    function devId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function devGame(value) {
      return value in ['chicago', 'minnesota', '301', '501', 'cricket', 'spanish'];
    }

    // Profile documents deliberately contain no email, authentication claims,
    // lifetime counters, or other private account information.
    match /blakeoutDevProfiles/{uid} {
      allow read: if devVerified();
      allow create, update: if devVerified() && request.auth.uid == uid && devId(uid)
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.keys().hasOnly(['name'])
        && devText(request.resource.data.name, 40)
        && request.resource.data.name.trim().size() > 0;
      allow delete: if false;
    }

    // Canonical key order is produced only at the platform storage boundary.
    // These grammars reject unknown nested keys without iterating 64+ entries.
    function devRegistrationPayload(value) {
      let text = '"([^"@\\\\\\x00-\\x1F]|\\\\["\\\\/bfnrt])*"';
      let entry = '\\{"id":' + text + ',"playerId":(null|' + text
        + '),"name":' + text + ',"tag":' + text + '\\}';
      return value.matches('^\\[(' + entry + '(,' + entry + ')*)?\\]$');
    }

    function devPrivateRosterPayload(value) {
      let text = '"([^"@\\\\\\x00-\\x1F]|\\\\["\\\\/bfnrt])*"';
      let entry = '\\{"id":' + text
        + ',"paid":(true|false),"checkedIn":(true|false),"standby":(true|false)\\}';
      return value.matches('^\\[(' + entry + '(,' + entry + ')*)?\\]$');
    }

    function devTeamPayload(value) {
      let text = '"([^"@\\\\\\x00-\\x1F]|\\\\["\\\\/bfnrt])*"';
      let entry = '\\{"id":' + text + ',"name":' + text
        + ',"memberIds":\\[' + text + '(,' + text + ')?\\]\\}';
      return value.matches('^\\[(' + entry + '(,' + entry + ')*)?\\]$');
    }

    function devMatchPayload(value) {
      let text = '"([^"@\\\\\\x00-\\x1F]|\\\\["\\\\/bfnrt])*"';
      let nullable = '(null|' + text + ')';
      let source = '(null|\\{"teamId":' + text + '\\}|\\{"matchCode":'
        + text + ',"outcome":"(winner|loser)"\\})';
      let entry = '\\{"id":' + text + ',"code":' + text
        + ',"bracket":"(winners|losers|final|reset)","round":[0-9]+,"position":[0-9]+'
        + ',"sourceA":' + source + ',"sourceB":' + source
        + ',"teamA":' + nullable + ',"teamB":' + nullable
        + ',"status":"(pending|ready|complete|bye|void)","winnerId":' + nullable
        + ',"scoreA":(null|[0-9]+),"scoreB":(null|[0-9]+),"forfeit":(true|false)\\}';
      return value.matches('^\\[(' + entry + '(,' + entry + ')*)?\\]$');
    }

    function devTournament(data, id) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'date', 'gameType',
          'bestOf', 'status', 'registrations', 'teams', 'matches',
          'revision', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'date', 'gameType',
          'bestOf', 'status', 'registrations', 'teams', 'matches',
          'revision', 'createdAt', 'updatedAt'])
        && devId(id) && data.id == id && devId(data.ownerId)
        && devText(data.title, 100) && data.title.size() > 0
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && devGame(data.gameType)
        && data.bestOf is int && data.bestOf >= 1 && data.bestOf <= 99
        && data.bestOf % 2 == 1 && (data.gameType != 'chicago' || data.bestOf == 3)
        && data.status in ['registration', 'live', 'complete']
        // Public arrays are JSON strings on the wire (platform.js decodes them).
        // Grammars allow normal JSON quote/backslash/control escapes but never
        // Unicode escapes, so an escaped @ cannot bypass the no-email check.
        // Unicode names are stored literally. Counters/emails never belong here.
        && devText(data.registrations, 100000)
        && devText(data.teams, 50000)
        && devText(data.matches, 200000)
        && devRegistrationPayload(data.registrations)
        && devTeamPayload(data.teams)
        && devMatchPayload(data.matches)
        && data.revision is int && data.revision >= 0
        && data.createdAt is int && data.createdAt > 0
        && data.updatedAt is int && data.updatedAt >= data.createdAt;
    }

    match /blakeoutDevTournaments/{id} {
      allow read: if devVerified();
      allow create: if devVerified() && devTournament(request.resource.data, id)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.revision == 0
        && request.resource.data.status == 'registration'
        && devPairedPrivateRoster(id, request.resource.data)
        && devPairedSignupState(id, request.resource.data.revision);
      allow update: if devVerified() && resource.data.ownerId == request.auth.uid
        && devTournament(request.resource.data, id)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == devNextRevision(id, resource.data.revision)
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && devPairedPrivateRoster(id, request.resource.data)
        && devPairedSignupState(id, request.resource.data.revision);
      allow delete: if false;
    }

    function devPairedPrivateRoster(id, tournament) {
      let metadata = getAfter(/databases/$(database)/documents/blakeoutDevRosterPrivate/$(id)).data;
      return metadata.ownerId == tournament.ownerId
        && metadata.tournamentId == id && metadata.revision == tournament.revision;
    }

    function devPrivateRoster(data, id) {
      return data.keys().hasAll(['tournamentId', 'ownerId', 'revision', 'registrations'])
        && data.keys().hasOnly(['tournamentId', 'ownerId', 'revision', 'registrations'])
        && devId(id) && data.tournamentId == id && data.ownerId == request.auth.uid
        && data.revision is int && data.revision >= 0
        && devText(data.registrations, 100000) && devPrivateRosterPayload(data.registrations)
        && getAfter(/databases/$(database)/documents/blakeoutDevTournaments/$(id)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/blakeoutDevTournaments/$(id)).data.revision == data.revision;
    }

    match /blakeoutDevRosterPrivate/{id} {
      // Absent-document reads allow atomic creation, but never reveal another
      // organizer's roster flags. Listing is deliberately not supported.
      allow get: if devVerified()
        && (!exists(/databases/$(database)/documents/blakeoutDevRosterPrivate/$(id))
          || resource.data.ownerId == request.auth.uid);
      allow list: if false;
      allow create: if devVerified() && devPrivateRoster(request.resource.data, id)
        && request.resource.data.revision == 0;
      allow update: if devVerified() && resource.data.ownerId == request.auth.uid
        && devPrivateRoster(request.resource.data, id)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.revision == devNextRevision(id, resource.data.revision);
      allow delete: if false;
    }

    // Fresh events require atomic signup state; no legacy data is migrated.
    // Missing-state fallback is needed when computing revision zero on creation.
    function devNextRevision(id, legacyRevision) {
      return exists(/databases/$(database)/documents/blakeoutDevSignupState/$(id))
        ? get(/databases/$(database)/documents/blakeoutDevSignupState/$(id)).data.revision + 1
        : legacyRevision + 1;
    }

    function devPairedSignupState(id, revision) {
      return existsAfter(/databases/$(database)/documents/blakeoutDevSignupState/$(id))
        && (getAfter(/databases/$(database)/documents/blakeoutDevSignupState/$(id)).data.revision == revision
          && getAfter(/databases/$(database)/documents/blakeoutDevSignupState/$(id)).data.lastJoiner == null);
    }

    function devSignupOwnerWrite(id, revision) {
      return getAfter(/databases/$(database)/documents/blakeoutDevTournaments/$(id)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/blakeoutDevTournaments/$(id)).data.revision == revision;
    }

    function devSelfJoin(id, revision) {
      return get(/databases/$(database)/documents/blakeoutDevTournaments/$(id)).data.status == 'registration'
        && !exists(/databases/$(database)/documents/blakeoutDevSignups/$(id)/players/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/blakeoutDevSignups/$(id)/players/$(request.auth.uid)).data.joinRevision == revision;
    }

    function devSignupMembers(id) {
      return exists(/databases/$(database)/documents/blakeoutDevSignupState/$(id))
        ? get(/databases/$(database)/documents/blakeoutDevSignupState/$(id)).data.members : [];
    }

    match /blakeoutDevSignupState/{id} {
      allow read: if devVerified();
      allow create, update: if devVerified() && devId(id)
        && request.resource.data.keys().hasAll(['tournamentId', 'revision', 'lastJoiner', 'members'])
        && request.resource.data.keys().hasOnly(['tournamentId', 'revision', 'lastJoiner', 'members'])
        && request.resource.data.tournamentId == id
        && request.resource.data.members is list && request.resource.data.members.size() <= 128
        && request.resource.data.members.toSet().size() == request.resource.data.members.size()
        && devUidList(request.resource.data.members)
        && request.resource.data.revision is int
        && request.resource.data.revision == (
          exists(/databases/$(database)/documents/blakeoutDevTournaments/$(id))
            ? devNextRevision(id, get(/databases/$(database)/documents/blakeoutDevTournaments/$(id)).data.revision)
            : 0)
        && ((devVerified() && request.resource.data.lastJoiner == null
              && request.resource.data.members.hasOnly(devSignupMembers(id))
              && devSignupOwnerWrite(id, request.resource.data.revision))
          || (request.resource.data.lastJoiner == request.auth.uid
              && request.resource.data.members == devSignupMembers(id).concat([request.auth.uid])
              && devSelfJoin(id, request.resource.data.revision)));
      allow delete: if false;
    }

    match /blakeoutDevSignups/{id}/players/{uid} {
      allow read: if devVerified();
      allow create: if devVerified() && uid == request.auth.uid && devId(uid)
        && request.resource.data.keys().hasAll(['playerId', 'registrationId', 'name', 'joinRevision'])
        && request.resource.data.keys().hasOnly(['playerId', 'registrationId', 'name', 'joinRevision'])
        && devText(request.resource.data.name, 40) && request.resource.data.name.trim().size() > 0
        && (request.resource.data.playerId == uid
            && request.resource.data.registrationId == 'self-' + uid
            && request.resource.data.name == get(/databases/$(database)/documents/blakeoutDevProfiles/$(uid)).data.name)
        && get(/databases/$(database)/documents/blakeoutDevTournaments/$(id)).data.status == 'registration'
        && getAfter(/databases/$(database)/documents/blakeoutDevSignupState/$(id)).data.lastJoiner == uid
        && request.resource.data.joinRevision == getAfter(/databases/$(database)/documents/blakeoutDevSignupState/$(id)).data.revision;
      allow update: if false;
      allow delete: if devVerified()
        && get(/databases/$(database)/documents/blakeoutDevTournaments/$(id)).data.ownerId == request.auth.uid
        && devSignupOwnerWrite(id, getAfter(/databases/$(database)/documents/blakeoutDevSignupState/$(id)).data.revision)
        && getAfter(/databases/$(database)/documents/blakeoutDevSignupState/$(id)).data.lastJoiner == null
        && !(uid in getAfter(/databases/$(database)/documents/blakeoutDevSignupState/$(id)).data.members)
        && getAfter(/databases/$(database)/documents/blakeoutDevSignupState/$(id)).data.revision
          == devNextRevision(id, get(/databases/$(database)/documents/blakeoutDevTournaments/$(id)).data.revision);
    }

    function devUidList(ids) {
      return ids is list && ids.size() <= 128
        && (ids.size() == 0 || (ids == ids.join(',').split(',')
          && ids.join(',').matches('^[A-Za-z0-9_-]{1,128}(,[A-Za-z0-9_-]{1,128})*$'));
    }

    function devBackend(data) {
      return data.get('backendKey', '') == 'blakeout-darts-dev:1:901185136996:web:89d4f413520e66ff773271';
    }

    function devLegScores(value) {
      let entry = "\\{\"id\":\"[A-Za-z0-9_-]{1,128}\",\"gameType\":\"(301|501|701|801|901|1101|1501|cricket|spanish|minnesota|chaos|quickie|cutthroat|wildcard|hammer|teamhammer|chicago|121|baseball|bermuda|golf|shanghai|countup|gotcha|sharktank|tictactoe|robinhood|doubledown|teamcricket)\",\"winnerId\":(null|\"[A-Za-z0-9_-]{1,128}\")\\}";
      return value is string && value.size() <= 50000
        && value.matches('^\\[(' + entry + '(,' + entry + ')*)?\\]$')
        && (value == '[]' || value.split('\\},\\{').size() <= 99);
    }

    function devLedger(value, ids) {
      let id = '"[A-Za-z0-9_-]{1,128}"';
      let nullable = '(null|' + id + ')';
      let numeric = '(0|[1-9][0-9]{0,11})(\\.[0-9]{1,32})?([eE]-[0-9]{1,3})?';
      let player = ids.size() == 0 ? 'null' : '(null|"(' + ids.join('|') + ')")';
      let turn = '\\{"id":' + id + ',"registrationId":' + nullable + ',"playerId":' + player
        + ',"teamId":' + id + ',"points":' + numeric + ',"darts":[1-3],"marks":' + numeric + ',"bust":(true|false)\\}';
      let game = "(301|501|701|801|901|1101|1501|cricket|spanish|minnesota|chaos|quickie|cutthroat|wildcard|hammer|teamhammer|chicago|121|baseball|bermuda|golf|shanghai|countup|gotcha|sharktank|tictactoe|robinhood|doubledown|teamcricket)";
      let leg = '\\{"id":' + id + ',"gameType":"' + game + '","winnerId":' + nullable
        + ',"minnesotaCutthroat":(true|false),"turns":\\[(' + turn + '(,' + turn + ')*)?\\]\\}';
      return value == null || (value is string && value.size() <= 700000
        && value.matches('^\\{"id":' + id + ',"legs":\\[(' + leg + '(,' + leg + ')*)?\\],"winnerIds":\\[(' + id + '(,' + id + ')*)?\\]\\}$')
        && value.split('"turns":').size() <= 100
        && value.split('"winnerIds":')[1].split(',').size() <= 128
        && !value.matches('.*"gameType":"(301|501|701|801|901|1101|1501|cricket|spanish|chaos|quickie|cutthroat|wildcard|hammer|teamhammer|chicago|121|baseball|bermuda|golf|shanghai|countup|gotcha|sharktank|tictactoe|robinhood|doubledown|teamcricket)","winnerId":' + nullable + ',"minnesotaCutthroat":true.*'));
    }

    function devResultExtras(data) {
      return devBackend(data)
        && (!data.keys().hasAny(['records']) || data.records is string)
        && (data.get('winnerId', null) == null || devId(data.winnerId))
        && data.get('scoreA', 0) is int && data.get('scoreA', 0) >= 0 && data.get('scoreA', 0) <= 99
        && data.get('scoreB', 0) is int && data.get('scoreB', 0) >= 0 && data.get('scoreB', 0) <= 99
        && data.get('forfeit', false) is bool
        && data.get('minnesotaCutthroat', false) is bool
        && (!data.get('minnesotaCutthroat', false) || data.gameType == 'minnesota')
        && devLedger(data.get('records', null), data.participantIds);
    }

    function devParticipant(ids, index) {
      return ids.size() <= index || (devId(ids[index])
        && exists(/databases/$(database)/documents/blakeoutDevProfiles/$(ids[index])));
    }

    // Repeated per-map validation exceeded Firestore's 1000-expression budget
    // with full doubles results. Canonical JSON checks all 12 Chicago counters
    // in one regex. IDs have already passed devId, so this alternation cannot
    // inject regex syntax. APIs decode the wire string back to ordinary arrays.
    function devResultCounters(value, ids) {
      let players = (ids.size() > 0 ? ids[0] : '')
        + (ids.size() > 1 ? '|' + ids[1] : '')
        + (ids.size() > 2 ? '|' + ids[2] : '')
        + (ids.size() > 3 ? '|' + ids[3] : '');
      let whole = '(0|[1-9][0-9]{0,11})';
      let numeric = whole + '(\\.[0-9]{1,32})?([eE]-[0-9]{1,3})?';
      let entry = '\\{"playerId":"(' + players
        + ')","gameType":"(chicago|minnesota|301|501|cricket|spanish)","points":' + numeric
        + ',"darts":' + whole + ',"marks":' + numeric + '\\}';
      return value is string && value.size() <= 8192
        && ((ids.size() == 0 && value == '[]')
          || (ids.size() > 0 && value.matches('^\\[(' + entry + '(,' + entry + '){0,11})?\\]$')));
    }

    function devResult(data) {
      return data.keys().hasAll(['ownerId', 'tournamentId', 'participantIds',
          'perPlayer', 'gameType', 'matchId', 'legScores', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'tournamentId', 'participantIds',
          'perPlayer', 'gameType', 'matchId', 'legScores', 'createdAt',
          'winnerId', 'scoreA', 'scoreB', 'forfeit', 'records', 'minnesotaCutthroat', 'backendKey'])
        && devId(data.ownerId) && devId(data.tournamentId)
        && devText(data.matchId, 100) && data.matchId.size() > 0
        && devGame(data.gameType)
        && data.createdAt is int && data.createdAt > 0
        && data.participantIds is list && data.participantIds.size() <= 4
        && data.participantIds.toSet().size() == data.participantIds.size()
        && devParticipant(data.participantIds, 0)
        && devParticipant(data.participantIds, 1)
        && devParticipant(data.participantIds, 2)
        && devParticipant(data.participantIds, 3)
        && devResultCounters(data.perPlayer, data.participantIds)
        && devLegScores(data.legScores)
        && devResultExtras(data);
    }

    match /blakeoutDevResults/{id} {
      // A verified transaction may check an absent result ID for idempotency.
      allow get: if devVerified()
        && (!exists(/databases/$(database)/documents/blakeoutDevResults/$(id))
          || resource.data.ownerId == request.auth.uid
          || request.auth.uid in resource.data.participantIds);
      allow list: if devVerified()
        && (resource.data.ownerId == request.auth.uid
          || request.auth.uid in resource.data.participantIds);
      allow create: if devVerified() && devId(id)
        && devResult(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/blakeoutDevTournaments/$(request.resource.data.tournamentId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/blakeoutDevTournaments/$(request.resource.data.tournamentId)).data.status == 'live'
        && request.resource.data.gameType == get(/databases/$(database)/documents/blakeoutDevTournaments/$(request.resource.data.tournamentId)).data.gameType
        && getAfter(/databases/$(database)/documents/blakeoutDevTournaments/$(request.resource.data.tournamentId)).data.status in ['live', 'complete']
        && getAfter(/databases/$(database)/documents/blakeoutDevTournaments/$(request.resource.data.tournamentId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/blakeoutDevTournaments/$(request.resource.data.tournamentId)).data.revision
          == devNextRevision(request.resource.data.tournamentId,
            get(/databases/$(database)/documents/blakeoutDevTournaments/$(request.resource.data.tournamentId)).data.revision);
      allow update, delete: if false;
    }

    function devCasualGame(value) {
      return value in ['301', '501', '701', '801', '901', '1101', '1501',
        'cricket', 'spanish', 'minnesota', 'chaos', 'quickie', 'cutthroat',
        'wildcard', 'hammer', 'teamhammer', 'chicago', '121', 'baseball',
        'bermuda', 'golf', 'shanghai', 'countup', 'gotcha', 'sharktank',
        'tictactoe', 'robinhood', 'doubledown', 'teamcricket'];
    }

    function devCasualCounters(value, ids) {
      let games = '(301|501|701|801|901|1101|1501|cricket|spanish|minnesota|chaos|quickie|cutthroat|wildcard|hammer|teamhammer|chicago|121|baseball|bermuda|golf|shanghai|countup|gotcha|sharktank|tictactoe|robinhood|doubledown|teamcricket)';
      let whole = '(0|[1-9][0-9]{0,11})';
      let numeric = whole + '(\\.[0-9]{1,32})?([eE]-[0-9]{1,3})?';
      let entry = '\\{"playerId":"(' + ids.join('|') + ')","gameType":"' + games
        + '","points":' + numeric + ',"darts":' + whole + ',"marks":' + numeric + '\\}';
      // A bounded repetition would expand the 128-UID alternation hundreds of
      // times in RE2. Flat canonical objects permit a separate native count.
      return value is string && value.size() <= 100000
        && ((ids.size() == 0 && value == '[]')
          || (ids.size() > 0 && value.matches('^\\[(' + entry + '(,' + entry + ')*)?\\]$')
            && value.split('\\},\\{').size() <= 384));
    }

    match /blakeoutDevCasualResults/{id} {
      allow get: if devVerified()
        && (!exists(/databases/$(database)/documents/blakeoutDevCasualResults/$(id))
          || resource.data.ownerId == request.auth.uid
          || exists(/databases/$(database)/documents/blakeoutDevCasualReceipts/$(id + '$' + request.auth.uid)));
      allow list: if devVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if devVerified() && devId(id)
        && request.resource.data.keys().hasAll(['ownerId', 'participantIds', 'perPlayer', 'gameType', 'matchId', 'legScores', 'createdAt'])
        && request.resource.data.keys().hasOnly(['ownerId', 'participantIds', 'perPlayer', 'gameType', 'matchId', 'legScores', 'createdAt', 'winnerId', 'winnerIds', 'scoreA', 'scoreB', 'forfeit', 'records', 'minnesotaCutthroat', 'backendKey'])
        && request.resource.data.ownerId == request.auth.uid
        && devCasualGame(request.resource.data.gameType)
        && devText(request.resource.data.matchId, 128) && request.resource.data.matchId.size() > 0
        && request.resource.data.createdAt is int && request.resource.data.createdAt > 0
        && request.resource.data.get('winnerIds', []) is list
        && request.resource.data.get('winnerIds', []).size() <= 128
        && (request.resource.data.get('winnerIds', []).size() == 0
          || (request.resource.data.winnerIds == request.resource.data.winnerIds.join(',').split(',')
            && request.resource.data.winnerIds.join(',').matches('^[A-Za-z0-9_-]{1,128}(,[A-Za-z0-9_-]{1,128})*$')))
        && devLegScores(request.resource.data.legScores)
        && request.resource.data.participantIds is list && request.resource.data.participantIds.size() <= 128
        && request.resource.data.participantIds.toSet().size() == request.resource.data.participantIds.size()
        && (request.resource.data.participantIds.size() == 0
          || (request.resource.data.participantIds == request.resource.data.participantIds.join(',').split(',')
            && request.resource.data.participantIds.join(',').matches('^[A-Za-z0-9_-]{1,128}(,[A-Za-z0-9_-]{1,128})*$')))
        && devCasualCounters(request.resource.data.perPlayer, request.resource.data.participantIds)
        && devResultExtras(request.resource.data);
      allow update, delete: if false;
    }

    match /blakeoutDevCasualReceipts/{id} {
      allow get: if devVerified()
        && (!exists(/databases/$(database)/documents/blakeoutDevCasualReceipts/$(id))
          || resource.data.playerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow list: if devVerified() && resource.data.playerId == request.auth.uid;
      allow create: if devVerified()
        && request.resource.data.keys().hasAll(['resultId', 'playerId', 'ownerId', 'backendKey'])
        && request.resource.data.keys().hasOnly(['resultId', 'playerId', 'ownerId', 'backendKey'])
        && devBackend(request.resource.data)
        && devBackend(get(/databases/$(database)/documents/blakeoutDevCasualResults/$(request.resource.data.resultId)).data)
        && devId(request.resource.data.resultId) && devId(request.resource.data.playerId)
        && id == request.resource.data.resultId + '$' + request.resource.data.playerId
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/blakeoutDevCasualResults/$(request.resource.data.resultId)).data.ownerId == request.auth.uid
        && request.resource.data.playerId in get(/databases/$(database)/documents/blakeoutDevCasualResults/$(request.resource.data.resultId)).data.participantIds
        && exists(/databases/$(database)/documents/blakeoutDevProfiles/$(request.resource.data.playerId));
      allow update, delete: if false;
    }

    // No grants for legacy roster(s), usage, other collections or subcollections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
